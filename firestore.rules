rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mallaramlokesh13@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isMentor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.mentorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    // AI Evaluations
    match /aiEvaluations/{evalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Collaboration Requests
    match /collaborationRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // Funding Requests
    match /fundingRequests/{fundingId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isMentor()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.studentId == request.auth.uid && resource.data.status == 'Pending')
      );
      allow delete: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isMentor()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.studentId == request.auth.uid && resource.data.status == 'Pending')
      );
      allow delete: if isAdmin();
    }

    // Milestones
    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && isAdmin();
    }

    // Project Reviews
    match /projectReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Mentor Notes
    match /mentorNotes/{noteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
